{
  "manifest_version": 3,
  "name": "Format Cleaner for Gmail",
  "short_name": "Format Cleaner",
  "version": "1.1.0",
  "description": "Một nút bấm đưa thư về chuẩn: cỡ chữ, font, màu, giãn dòng. Tự làm sạch định dạng khi dán từ Word, Docs, web và VS Code.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Cài đặt chuẩn định dạng thư",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/sanitizer.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
